{
  "name": "cv-tool",
  "version": "0.0.0",
  "description": "Adapta CVs y cartas de presentación a ofertas de trabajo y lleva un tracker de postulaciones.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "cv-tool": "bin/cv-tool.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node bin/cv-tool.js",
    "prototype": "tsx scripts/prototype.ts",
    "test": "vitest run",
    "lint": "biome check src scripts tests bin vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json biome.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^13.0.3",
    "env-paths": "^4.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
